extends ../include/index-page-master-layout.pug

block internal_css

    style.

        body {
            background:
                radial-gradient(circle at top left, rgba(14,165,233,0.08), transparent 30%),
                radial-gradient(circle at bottom right, rgba(34,197,94,0.08), transparent 30%),
                linear-gradient(to bottom, #f8fafc, #f1f5f9);
        }

        .digital-lib-card {
            position: relative;
            overflow: hidden;
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(226,232,240,0.9);
            box-shadow:
                0 10px 25px rgba(15,23,42,0.05),
                0 2px 8px rgba(15,23,42,0.03);
            transition: all 0.35s ease;
            backdrop-filter: blur(12px);
        }

        .digital-lib-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                135deg,
                rgba(14,165,233,0.03),
                rgba(34,197,94,0.03)
            );
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .digital-lib-card:hover {
            transform: translateY(-5px);
            border-color: rgba(14,165,233,0.25);
            box-shadow:
                0 20px 40px rgba(15,23,42,0.08),
                0 10px 15px rgba(14,165,233,0.06);
        }

        .digital-lib-card:hover::before {
            opacity: 1;
        }

        .book-link {
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
            border: 1px solid transparent;
        }

        .book-link::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to right,
                rgba(239,246,255,0.8),
                rgba(240,253,244,0.8)
            );
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .book-link:hover::before {
            opacity: 1;
        }

        .book-link:hover {
            border-color: #bfdbfe;
            transform: translateX(4px);
        }

        .hero-glass {
            backdrop-filter: blur(20px);
            background: rgba(255,255,255,0.65);
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: 0 8px 24px rgba(15,23,42,0.05);
        }

        .floating-orb {
            animation: floatOrb 8s ease-in-out infinite;
        }

        @keyframes floatOrb {

            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        @media(max-width:640px) {

            .mobile-heading {
                font-size: 1.9rem !important;
                line-height: 2.4rem !important;
            }

            .mobile-subheading {
                font-size: 0.9rem !important;
                line-height: 1.5rem !important;
            }

            .book-title {
                font-size: 0.82rem !important;
                line-height: 1.25rem !important;
            }

            .digital-lib-card {
                border-radius: 1.2rem !important;
            }

            .mobile-book-icon {
                width: 2.7rem !important;
                height: 2.7rem !important;
                min-width: 2.7rem !important;
            }
        }


block content

    section(class='relative py-10 md:py-16 overflow-hidden')

        // Decorative Background
        div(class='floating-orb absolute top-0 left-0 w-72 h-72 bg-sky-200/30 rounded-full blur-3xl -z-10')
        div(class='floating-orb absolute bottom-0 right-0 w-80 h-80 bg-emerald-200/30 rounded-full blur-3xl -z-10')

        div(class='container mx-auto px-4')

            // HERO SECTION
            div(class='max-w-5xl mx-auto text-center mb-12 md:mb-16')

                div(class='hero-glass inline-flex items-center gap-3 rounded-full px-5 py-3')

                    div(class='w-10 h-10 rounded-full bg-gradient-to-br from-sky-500 to-cyan-500 flex items-center justify-center shadow-md')

                        i(class='fa-solid fa-book-open-reader text-white')

                    span(class='font-semibold tracking-wide text-slate-700')
                        | ग्रामपंचायत डिजिटल लायब्ररी

                h1(class='mobile-heading mt-6 text-4xl md:text-6xl font-black text-slate-800 tracking-tight leading-tight')

                    span(class='bg-gradient-to-r from-sky-700 to-emerald-600 bg-clip-text text-transparent')
                        | डिजिटल पुस्तकालय

                p(class='mobile-subheading mt-5 text-slate-500 text-sm md:text-lg leading-relaxed max-w-3xl mx-auto')

                    | स्पर्धा परीक्षा, शैक्षणिक अभ्यासक्रम, शासन योजना, ग्रामविकास आणि इतर महत्त्वपूर्ण पुस्तके आता एका क्लिकवर उपलब्ध.


            if digitalLib && digitalLib.length > 0

                -
                    let totalBooks = 0;

                    digitalLib.forEach(category => {
                        totalBooks += (category.books?.length || 0)
                    })


                // STATS
                div(class='grid grid-cols-2 md:grid-cols-4 gap-4 mb-10 md:mb-14')

                    div(class='hero-glass rounded-2xl p-5 text-center')

                        div(class='text-3xl font-black text-sky-700')
                            | #{digitalLib.length}

                        div(class='mt-1 text-sm text-slate-500')
                            | विभाग

                    div(class='hero-glass rounded-2xl p-5 text-center')

                        div(class='text-3xl font-black text-emerald-700')
                            | #{totalBooks}

                        div(class='mt-1 text-sm text-slate-500')
                            | पुस्तके

                    div(class='hero-glass rounded-2xl p-5 text-center')

                        div(class='text-3xl font-black text-violet-700')
                            | PDF

                        div(class='mt-1 text-sm text-slate-500')
                            | स्वरूप

                    div(class='hero-glass rounded-2xl p-5 text-center')

                        div(class='text-3xl font-black text-orange-700')
                            | Free

                        div(class='mt-1 text-sm text-slate-500')
                            | प्रवेश



                // LIBRARY GRID
                div(class='grid grid-cols-1 xl:grid-cols-2 gap-7')

                    each category in digitalLib

                        .digital-lib-card(class='rounded-3xl')

                            // HEADER
                            div(class='relative p-6 md:p-7 border-b border-slate-100')

                                div(class='flex items-start justify-between gap-4 relative z-10')

                                    div

                                        div(class='inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-700 text-xs font-semibold mb-3')

                                            i(class='fa-solid fa-layer-group')

                                            span विभाग

                                        h2(class='text-xl md:text-2xl font-black text-slate-800 leading-snug')

                                            | #{category.title}

                                        if category.subtitle

                                            p(class='mt-2 text-sm text-slate-500 leading-relaxed')

                                                | #{category.subtitle}

                                    div(class='hidden md:flex w-16 h-16 rounded-2xl bg-gradient-to-br from-sky-500 to-emerald-500 shadow-lg items-center justify-center')

                                        i(class='fa-solid fa-books text-white text-2xl')


                            // BOOKS
                            div(class='p-4 md:p-5 flex flex-col gap-3 relative z-10')

                                if category.books && category.books.length > 0

                                    each book in category.books

                                        a(
                                            href=book.link
                                            target='_blank'
                                            class='book-link rounded-2xl bg-slate-50/80 p-4 flex items-center justify-between gap-3'
                                        )

                                            div(class='relative z-10 flex items-start gap-4 min-w-0')

                                                div(class='mobile-book-icon w-12 h-12 min-w-[48px] rounded-2xl bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center shadow-md')

                                                    i(class='fa-solid fa-file-pdf text-white text-lg')

                                                div(class='min-w-0')

                                                    h4(class='book-title text-sm md:text-base font-bold text-slate-800 break-words')

                                                        | #{book.name}

                                                    div(class='mt-1 flex items-center gap-2 text-xs text-slate-400')

                                                        i(class='fa-regular fa-file-lines')

                                                        span PDF Document

                                            div(class='relative z-10 w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center')

                                                i(class='fa-solid fa-arrow-up-right-from-square text-slate-500 text-xs')


                                else

                                    div(class='text-center py-10 text-slate-400')

                                        div(class='w-20 h-20 mx-auto rounded-full bg-slate-100 flex items-center justify-center')

                                            i(class='fa-solid fa-book text-3xl')

                                        p(class='mt-4 text-sm')

                                            | पुस्तके उपलब्ध नाहीत


            else

                div(class='max-w-2xl mx-auto')

                    div(class='hero-glass rounded-3xl px-8 py-16 text-center')

                        div(class='w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center shadow-inner')

                            i(class='fa-solid fa-book-open text-4xl text-slate-400')

                        h3(class='mt-7 text-3xl font-black text-slate-700')

                            | डिजिटल लायब्ररी उपलब्ध नाही

                        p(class='mt-4 text-slate-500 text-sm md:text-base leading-relaxed')

                            | लवकरच नवीन पुस्तके आणि अभ्यास साहित्य येथे उपलब्ध करण्यात येतील.