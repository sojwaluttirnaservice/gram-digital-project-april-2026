extends ../include/print-page-tailwind-layout.pug

block custom_css 
    style.
        @media print {
            @page {
                size: A4 landscape;
                margin: 4mm 6mm;
            }
            body {
                margin: 0;
                padding: 0;
                background: white;
            }
            .hide-print {
                display: none !important;
            }
            .my-print-container {
                border: none !important;
                padding: 0 !important;
                box-shadow: none !important;
                max-width: 100% !important;
                margin: 0 !important;
            }
            .inner-frame {
                border: 2px double #334155 !important;
                padding: 12px 16px !important;
                min-height: 194mm !important;
                max-height: 194mm !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: space-between !important;
                box-sizing: border-box !important;
            }
            table {
                margin-top: 0.25rem !important;
                margin-bottom: 0.25rem !important;
            }
            th {
                padding: 0.35rem 0.25rem !important;
                font-size: 0.75rem !important;
            }
            td {
                padding: 0.3rem 0.4rem !important;
                font-size: 0.72rem !important;
            }
            .mt-10 {
                margin-top: 0.75rem !important;
            }
            .h-24 {
                height: 4.5rem !important;
            }
            .mb-4 {
                margin-bottom: 0.5rem !important;
            }
            .mt-8 {
                margin-top: 0.5rem !important;
            }
        }

        .inner-frame {
            border: 3px double #334155;
            padding: 20px;
            min-height: 184mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-sizing: border-box;
            background-color: white;
            border-radius: 8px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        th {
            background-color: #f1f5f9;
            color: #0f172a;
            font-weight: 800;
            text-align: center;
            vertical-align: middle;
            border: 1px solid #cbd5e1;
            padding: 0.5rem 0.4rem;
            font-size: 0.8rem;
            letter-spacing: 0.025em;
        }

        td {
            padding: 0.45rem 0.6rem;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
            font-size: 0.78rem;
            color: #334155;
            text-align: center;
        }

        td:nth-child(2) {
            text-align: left;
            font-weight: 600;
            color: #0f172a;
        }

        tr:nth-child(even) {
            background-color: #f8fafc;
        }

        tr:hover {
            background-color: #f1f5f9;
        }


block content 
    body.tiro-devanagari-marathi-regular

        - const getMonthName = m => ({1:'जानेवारी',2:'फेब्रुवारी',3:'मार्च',4:'एप्रिल',5:'मे',6:'जून',7:'जुलै',8:'ऑगस्ट',9:'सप्टेंबर',10:'ऑक्टोबर',11:'नोव्हेंबर',12:'डिसेंबर'})[m]

