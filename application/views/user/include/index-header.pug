mixin dropdown(btnId, btnLabel, btnClass)
    div(class="relative block text-left")
        div(class='w-full')
            button(class=btnClass data-toggle-dropdown id=btnId aria-expanded="false" aria-haspopup="true") 
                span #{btnLabel}
                svg.-mr-1.ml-2.h-5.w-5(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true")
                    path(fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd")
        div(class="hidden origin-top-right absolute right-0 mt-2 min-w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-50" role="menu" aria-orientation="vertical" aria-labelledby=btnId tabindex="-1")
            div(class="py-1" role="none")
                block

