//- keeping the modal for qR generation over here only

dialog#qr-code-modal.modal
    .modal-box(class='bg-white')

        form(method="dialog")

            - let qrText = { mr: 'QR', hi: 'QR', en: 'QR' };

            h3(class='text-center text-gray-500 font-bold text-xl') 
                span#qr-modal-title
                span &nbsp; #{qrText[language]}

            div(class='flex justify-center')  
                button#qr-download-btn(class="mt-4 flex items-center justify-center gap-2 bg-gradient-to-r from-blue-500 to-blue-700 hover:from-blue-600 hover:to-blue-800 text-white font-semibold py-2 px-4 rounded-lg shadow-lg transition-all duration-200")
                        span Download QR
                        i(class="fa-solid fa-download")
            button.btn.btn-sm.btn-circle.btn-ghost.absolute.right-2.top-2 ✕

        .p-4(class='md:p-5')
            .modal-body

                div(class='mt-4 flex items-center justify-center')
                    div(class='border' id='banner-qr-code')

