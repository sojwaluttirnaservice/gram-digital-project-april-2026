block internal_js
    script.
        $(document).ready(function () {
            // Tab switching handler
            $('.rti-tab-btn').on('click', function () {
                const tab = $(this).data('tab');

                $('.rti-tab-btn').removeClass('active');
                $(this).addClass('active');

                $('.tab-content').removeClass('active');
                $('.tab-content[data-tab="' + tab + '"]').addClass('active');
            });

            // Generic Accordion
            $('.accordion-btn').on('click', function () {
                const targetId = $(this).data('target');
                const $content = $('#' + targetId);
                const isOpening = !$content.is(':visible');

                // Close all other sections
                $('.accordion-body').not($content).slideUp();
                $('.accordion-btn').removeClass('active');
                $('.accordion-btn .icon').text('+');

                if (isOpening) {
                    $content.stop(true, true).slideDown();
                    $(this).addClass('active');
                    $(this).find('.icon').text('−');
                } else {
                    $content.stop(true, true).slideUp();
                }
            });

            /* =========================================================
            1. SPECIAL STYLING
            ========================================================= */

            /**
            * Highlight "restricted information" section
            * (item6 in your Pug)
            */
            $('#item6').parent().css({
                border: '1px solid #ef4444',
                background: '#fef2f2'
            });

            /* =========================================================
            2. DEFAULT STATES
            ========================================================= */

            // Activate first tab
            $('.rti-tab-btn').first().click();

            // Open first accordion item
            $('.accordion-btn').first().click();

            // RTI dynamic documents filtering
            const disclosures = !{JSON.stringify(disclosures || [])};

            // Select the latest year by default
            if (disclosures && disclosures.length > 0) {
                const yearsInDb = disclosures.map(d => `${d.from_year}-${d.to_year}`);
                const latestYear = yearsInDb.sort().reverse()[0];
                if (latestYear && $('#filter-financial-year option[value="' + latestYear + '"]').length > 0) {
                    $('#filter-financial-year').val(latestYear);
                }
            } else {
                let maxYear = '';
                $('#filter-financial-year option').each(function() {
                    const val = $(this).val();
                    if (val > maxYear) {
                        maxYear = val;
                    }
                });
                if (maxYear) {
                    $('#filter-financial-year').val(maxYear);
                }
            }

            function updateRtiFiles() {
                const selectedYear = $('#filter-financial-year').val();
                if (!selectedYear) return;
                const [fromYear, toYear] = selectedYear.split('-').map(Number);

                // Filter disclosures for the selected year
                const activeDocs = disclosures.filter(doc => doc.from_year === fromYear && doc.to_year === toYear);

                // Clear all containers
                $('.rti-docs-container').html('');
                $('.rti-header-docs-container').html('');

                // Distribute disclosures to their points
                activeDocs.forEach(doc => {
                    const pointNum = Number(doc.point_number);
                    
                    // HTML for document inside accordion body
                    const docHtml = `
                        <div class="flex items-center justify-between p-3 bg-[#138f78]/5 border border-[#138f78]/15 rounded-lg hover:bg-[#138f78]/10 transition-colors duration-150 my-2">
                            <div class="flex items-center space-x-3">
                                <i class="fa fa-file-pdf-o text-red-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-sm font-medium text-gray-800">${doc.description || doc.document_name}</p>
                                </div>
                            </div>
                            <a href="${doc.saved_path}" target="_blank" class="px-3 py-1 bg-[#138f78] hover:bg-[#0f6c5a] text-white rounded text-xs font-semibold shadow-sm transition-all duration-150">
                                <i class="fa fa-download mr-1"></i> पहा / डाउनलोड
                            </a>
                        </div>
                    `;

                    // HTML for document in accordion header (inline)
                    const headerDocHtml = `
                        <a href="${doc.saved_path}" target="_blank" class="px-2 py-1 bg-red-100 hover:bg-red-200 text-red-700 rounded-md text-xs font-semibold shadow-sm transition-all duration-150 flex items-center gap-1 border border-red-200" title="${doc.description || doc.document_name}">
                            <i class="fa fa-file-pdf-o"></i> PDF
                        </a>
                    `;

                    if (pointNum >= 1 && pointNum <= 17) {
                        $(`.rti-docs-container[data-point="${pointNum}"]`).append(docHtml);
                        $(`.rti-header-docs-container[data-point="${pointNum}"]`).append(headerDocHtml);
                    }
                });

                // Populate placeholder message for points with no docs
                $('.rti-docs-container').each(function() {
                    if ($(this).children().length === 0) {
                        $(this).html('<p class="text-xs text-gray-400 italic"><i class="fa fa-info-circle mr-1"></i> या आर्थिक वर्षासाठी कोणतेही दस्तऐवज उपलब्ध नाही.</p>');
                    }
                });
            }

            // Prevent accordion toggle when clicking inline header PDF buttons
            $(document).on('click', '.rti-header-docs-container a', function(e) {
                e.stopPropagation();
            });

            // Bind event listener
            $('#filter-financial-year').on('change', updateRtiFiles);

            // Initialize on page load
            updateRtiFiles();

        });
