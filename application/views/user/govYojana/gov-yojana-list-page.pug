//- =======================================================
//- OUTSIDE MASTER LAYOUT
//- =======================================================
extends ../include/index-page-master-layout.pug

block internal_css

block content

    section(class='py-8 md:py-14 bg-gradient-to-b from-sky-50 to-green-50 min-h-screen')

        div(class='container mx-auto px-4')

            //- ===================================================
            //- PAGE HEADER
            //- ===================================================
            div(class='text-center mb-10')

                div(class='inline-flex items-center justify-center w-20 h-20 rounded-full bg-white shadow-md text-sky-700 mb-4')
                    i(class='fa fa-university text-4xl')

                h1(class='text-3xl md:text-5xl font-bold text-gray-800 mb-3')
                    | शासकीय योजना माहिती

                p(class='text-gray-600 max-w-3xl mx-auto text-base md:text-lg')
                    | ग्रामपंचायत अंतर्गत उपलब्ध विविध शासकीय योजना, आवश्यक कागदपत्रे, अर्ज प्रक्रिया व अधिकृत माहिती


            //- ===================================================
            //- ACCORDION LIST
            //- ===================================================
            if govYojanaList && govYojanaList.length > 0

                div(class='max-w-6xl mx-auto space-y-5')

                    each item, index in govYojanaList
                        - var beneficiaryLists = []
                        - try { beneficiaryLists = typeof item.beneficiaryLists === 'string' ? JSON.parse(item.beneficiaryLists) : (item.beneficiaryLists || []) } catch(e) {}
                        - var requiredDocs = []
                        - try { requiredDocs = typeof item.required_documents_list === 'string' ? JSON.parse(item.required_documents_list) : (item.required_documents_list || []) } catch(e) {}

                        details(class='group bg-white rounded-3xl overflow-hidden shadow-md border border-gray-100 open:shadow-lg open:border-sky-200 transition duration-300')

                            summary(class='list-none cursor-pointer')

                                div(class='flex flex-col lg:flex-row items-stretch hover:bg-sky-50/30 transition duration-300 p-2')

                                    //- LEFT SIDE: Banner Image (Full width on mobile, left column on desktop)
                                    if item.image_banner
                                        div(class='w-full lg:w-5/12 xl:w-4/12 bg-slate-50 border-b lg:border-b-0 lg:border-r border-gray-100 flex items-center justify-center relative overflow-hidden min-h-[220px] lg:min-h-full flex-shrink-0')
                                            img(src=`/uploads/images/yojana/banners/${item.image_banner}` alt=item.yojana_name class='w-full h-full object-contain hover:scale-[1.02] transition-transform duration-300 cursor-zoom-in' onclick='event.preventDefault(); event.stopPropagation(); window.open(this.src, "_blank");')
                                            
                                            //- Open in new tab overlay button (Using server-side variable concatenation to output a clean client-side path string)
                                            div(class='absolute top-3 right-3 bg-black/60 hover:bg-black/85 text-white rounded-full p-2.5 cursor-pointer transition shadow-md flex items-center justify-center gap-1.5 z-10' onclick="event.preventDefault(); event.stopPropagation(); window.open('/uploads/images/yojana/banners/' + '" + item.image_banner + "', '_blank');" title='नवीन टॅबमध्ये उघडा')
                                                i(class='fa fa-expand text-xs')
                                                span(class='text-[10px] font-bold pr-1') नवीन टॅब
                                    else
                                        div(class='w-full lg:w-5/12 xl:w-4/12 bg-gradient-to-br from-sky-50 to-green-50 border-b lg:border-b-0 lg:border-r border-gray-100 flex items-center justify-center min-h-[160px] lg:min-h-full flex-shrink-0')
                                            i(class='fa fa-university text-5xl text-sky-600/30')

                                    //- RIGHT SIDE: Details and Action buttons
                                    div(class='flex-1 p-6 lg:p-8 flex flex-col justify-between gap-6')

                                        //- Text Info Area
                                        div(class='space-y-4')

                                            div(class='flex flex-wrap items-center gap-3')

                                                if item.yojana_status === 'ONGOING'
                                                    span(class='px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold') सुरू
                                                else if item.yojana_status === 'UPCOMING'
                                                    span(class='px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold') आगामी
                                                else
                                                    span(class='px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-xs font-bold') पूर्ण

                                                span(class='text-xs text-gray-400 font-semibold') योजना क्र. #{index + 1}

                                                if beneficiaryLists && beneficiaryLists.length > 0
                                                    span(class='px-3 py-1 rounded-full bg-sky-100 text-sky-700 text-xs font-bold flex items-center gap-1.5')
                                                        i(class='fa fa-users text-[10px]')
                                                        | लाभार्थी यादी उपलब्ध (#{beneficiaryLists.length})

                                            h2(class='text-xl md:text-2xl font-bold text-gray-800 leading-tight group-hover:text-sky-700 transition duration-300')
                                                | #{item.yojana_name}

                                            p(class='text-gray-600 text-sm md:text-base leading-relaxed line-clamp-3')
                                                | #{item.yojana_description || 'सदर योजनेची माहिती उपलब्ध आहे.'}

                                        //- Actions Row
                                        div(class='flex flex-row items-center justify-between gap-4 border-t border-gray-100/80 pt-4')
                                            
                                            //- Buttons Group
                                            div(class='flex items-center gap-3')
                                                //- Document button (rendered unconditionally but invisible by default to reserve layout space and prevent shifting when toggled)
                                                a(href=item.file_name ? `/new-gp-page/main-page/files/gov-yojna-lists/${item.file_name}` : '#' target='_blank' onclick='event.stopPropagation();' class='inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium transition ' + (item.file_name ? '' : 'invisible pointer-events-none'))
                                                    i(class='fa fa-file-pdf-o')
                                                    | दस्तऐवज

                                                if item.website_link
                                                    a(href=item.website_link target='_blank' onclick='event.stopPropagation();' class='inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-green-600 hover:bg-green-700 text-white text-sm font-medium transition')
                                                        i(class='fa fa-external-link')
                                                        | अधिक माहिती

                                            //- Accordion toggle icon
                                            div(class='w-10 h-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 group-open:rotate-180 transition-transform duration-300 flex-shrink-0')
                                                i(class='fa fa-chevron-down')


                            //- ===================================================
                            //- ACCORDION BODY
                            //- ===================================================
                            div(class='border-t border-gray-100')

                                div(class='p-6 space-y-6')

                                    div(class='grid grid-cols-1 lg:grid-cols-2 gap-8')

                                        //- ===================================================
                                        //- DESCRIPTION
                                        //- ===================================================
                                        div(class='')

                                            h3(class='text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2')
                                                i(class='fa fa-info-circle text-sky-600')
                                                | योजना माहिती

                                            div(class='bg-sky-50 rounded-2xl p-5 text-gray-700 leading-relaxed')

                                                p(class='mb-0')
                                                    | #{item.yojana_description || 'सदर योजनेबाबत माहिती उपलब्ध आहे.'}


                                        //- ===================================================
                                        //- REQUIRED DOCUMENTS
                                        //- ===================================================
                                        div(class='')

                                            h3(class='text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2')
                                                i(class='fa fa-folder-open text-green-600')
                                                | आवश्यक कागदपत्रे

                                            if requiredDocs && requiredDocs.length > 0

                                                ul(class='space-y-3')

                                                    each doc in requiredDocs

                                                        li(class='flex items-start gap-3 bg-green-50 rounded-2xl px-4 py-3')

                                                            i(class='fa fa-check-circle text-green-600 mt-1')

                                                            span(class='text-gray-700 text-sm md:text-base')
                                                                | #{doc}

                                            else

                                                div(class='bg-gray-50 rounded-2xl p-5 text-gray-500')
                                                    | आवश्यक कागदपत्रांची माहिती उपलब्ध नाही.

                                    //- ===================================================
                                    //- BENEFICIARY LIST (NEW SECTION)
                                    //- ===================================================
                                    if beneficiaryLists && beneficiaryLists.length > 0

                                        div(class='border-t border-dashed border-gray-200 pt-6 mt-2')

                                            h3(class='text-base font-bold text-gray-800 mb-4 flex items-center gap-2')
                                                i(class='fa fa-users text-sky-600')
                                                | लाभार्थी यादी (वर्षनिहाय)

                                            div(class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4')

                                                each list in beneficiaryLists

                                                    a(href=list.file_name ? `/new-gp-page/main-page/files/gov-yojana-beneficiaries/${list.file_name}` : '#' target='_blank' class='group/card flex items-center justify-between p-4 bg-white rounded-2xl border border-gray-150 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.05)] hover:shadow-[0_8px_20px_-6px_rgba(14,165,233,0.15)] hover:border-sky-200 transition duration-300')

                                                        div(class='flex items-center gap-4')

                                                            div(class='w-12 h-12 rounded-xl bg-red-50 text-red-500 group-hover/card:bg-red-500 group-hover/card:text-white transition-colors duration-300 flex items-center justify-center flex-shrink-0')
                                                                i(class='fa fa-file-pdf-o text-xl')

                                                            div

                                                                span(class='inline-flex items-center text-xs font-bold tracking-wider text-sky-700 bg-sky-50 px-2.5 py-1 rounded-md uppercase')
                                                                    | FY #{list.from_year} - #{list.to_year}

                                                                h4(class='text-base font-bold text-gray-800 mt-1.5 line-clamp-1 group-hover/card:text-sky-700 transition-colors duration-300')
                                                                    | #{list.document_name}

                                                        div(class='w-8 h-8 rounded-full bg-slate-50 text-slate-400 group-hover/card:bg-sky-50 group-hover/card:text-sky-600 transition-all duration-300 flex items-center justify-center flex-shrink-0')
                                                            i(class='fa fa-chevron-right text-xs')


            //- ===================================================
            //- EMPTY STATE
            //- ===================================================
            else

                div(class='max-w-xl mx-auto bg-white rounded-3xl shadow-md p-10 text-center')

                    div(class='w-24 h-24 rounded-full bg-sky-100 flex items-center justify-center mx-auto mb-5')
                        i(class='fa fa-folder-open-o text-5xl text-sky-600')

                    h3(class='text-2xl font-bold text-gray-800 mb-3')
                        | कोणतीही योजना उपलब्ध नाही

                    p(class='text-gray-600')
                        | सध्या कोणतीही शासकीय योजना उपलब्ध नाही. कृपया नंतर पुन्हा भेट द्या.