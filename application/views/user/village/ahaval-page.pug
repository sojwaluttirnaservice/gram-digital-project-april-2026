extends ../include/index-page-master-layout.pug

block content
    section(class='py-10 md:py-16 bg-gray-50 min-h-screen')
        div(class='container mx-auto px-4 max-w-4xl')

            //- Page Header
            div(class='mb-8')
                h1(class='text-2xl md:text-3xl font-bold text-gray-800') ग्राम अहवाल
                p(class='text-gray-500 text-sm mt-1') ग्रामपंचायतीने प्रकाशित केलेले अधिकृत अहवाल व दस्तऐवज

            //- Document List
            if gram_ahaval_documents && gram_ahaval_documents.length > 0
                div(class='grid gap-4')
                    each doc, index in gram_ahaval_documents
                        - let filePath = `/new-gp-page/main-page/files/gram-ahaval-documents/${doc.document_file_name}`
                        a(
                            href=filePath
                            target='_blank'
                            class='flex items-center justify-between bg-white border border-gray-200 rounded-xl px-5 py-4 hover:border-[#138f78] hover:shadow-md transition-all duration-200 group'
                        )
                            div(class='flex items-center gap-4')
                                div(class='w-10 h-10 rounded-lg bg-[#138f78]/10 flex items-center justify-center text-[#138f78] flex-shrink-0')
                                    i(class='fa fa-file-pdf-o text-lg')
                                div
                                    p(class='font-semibold text-gray-800 group-hover:text-[#138f78] transition-colors') #{doc.document_name}
                                    p(class='text-xs text-gray-400 mt-0.5') अहवाल क्र. #{index + 1}
                            div(class='flex items-center gap-2 text-[#138f78] text-sm font-medium')
                                span(class='hidden sm:block') पहा / डाउनलोड
                                i(class='fa fa-download')

            else
                div(class='bg-white border border-gray-200 rounded-xl p-10 text-center')
                    i(class='fa fa-folder-open-o text-4xl text-gray-300 mb-3')
                    p(class='text-gray-500') सध्या कोणताही अहवाल उपलब्ध नाही.
