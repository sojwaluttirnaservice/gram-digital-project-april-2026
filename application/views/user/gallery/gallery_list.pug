extends ../include/internal-gp-master-layout.pug

block custom_css
    link(rel='stylesheet' href='/asstest/lightbox/dist/css/lightbox.css')
    style.
        .error {
            color:red !important;
            font-style:italic !important;
            font-weight:700 !important;
        }
        .bg-warning{
            background-color:#f0d688 !important;
        }
        body{
            height:100vh;
        }
        @media (min-width: 576px) {
            .modal-dialog { 
                max-width: none; 
            }
        }
        .modal-dialog {
            width: 98%;
            height: 92%;
            padding: 0;
        }

        a{
            text-decoration: none;
        }

        .gallery-container {
            width: 100%;
            min-height: 100vh;
            padding: 50px 8%;
        }

        .gallery {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 1rem;
        }

        .gallery img {
            width: 100%;
            height: 100%;
            border: 5px solid #d6d1d1;
            box-shadow: 0 3px 5px rgba(0, 0, 0, 0.3);
            object-fit: cover;
            transition: all 200ms ease-in-out;
        }

        .removeImage, .editImage {
            display: flex;
            gap: 0.3rem;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .gallery img:hover {
            transform: scale(1.03);
        }

        @media (max-width: 992px) {
            .gallery {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .gallery {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 576px) {
            .gallery {
                grid-template-columns: 1fr 1fr;
            }

            .removeImage, .editImage  {
                font-size: 0.8rem;
            }

            .gallery img {
                height: 7rem;
            }
        }

block content
    .modal#marriageModel(tabindex='-1' role='dialog')
        .modal-dialog(role='document' style="width:70% !important;")
            .modal-content
                .modal-header
                    h5.modal-title
                    button.close.close-modal-cross-btn(type='button' data-dismiss='marriageModel' aria-label='Close')
                        span(aria-hidden='true') ×
                .modal-body 
                    .row
                        .col-3
                        .col-6
                            form#gallery-form(enctype="multipart/form-data")
                                input(type="hidden" name="image_id" id="image_id")
                                input(type="hidden" name="mode" id="gallery_mode" value="add")
                                div(class='d-flex flex-column' style='gap:1rem;')
                                    input(name='imageFile')#image_1.form-control(type="file")
                                    input#image_title.form-control(name='g_image_title' placeholder='शीर्षक' required)
                                    input#image_desc.form-control(name='g_image_desc' placeholder='वर्णन' required)
                                div
                                    .text-center.mt-2
                                        button.btn.btn-primary(type="button" id="submit-gallery-img-btn") Submit
                        .col-12.mt-1
                            center
                                img#image-1-preview(width=600 height=300)
                                div#progress 
                                    progress#progress-bar(max="100" value="0")

    .container-fluid
        .row
            .col-12.mt-3
                h6.ml-5.text-center
                    span.text-primary.fa.fa-file-image-o.fa-2x.p-1
                        |  &nbsp;छायाचित्रे
                    if(!btn)
                        button.galleryAddModel.float-right.btn.btn-primary.btn-sm.mr-2(type="button")
                            span.fa.fa-image
                            |  नवीन छायाचित्रे जोडा 
            .col-10.offset-1.mt-3
                if(btn)
                    center 
                        h5.text-danger तुम्ही फक्त #{photoLimit} छायाचित्रे जोडू शकता ... नवीन जोडणीसाठी काही छायाचित्रे काढा !

            .gallery-container(style='background: ')
                .gallery
                    each image in gallery
                        .card 
                            .card-body
                                div
                                    -let galleryImagePath = link+image.g_image_name
                                    a(href=galleryImagePath, data-lightbox="models" data-title=image.g_image_desc)
                                        img.gallery-image(src=galleryImagePath)
                                    div 
                                        div.text-center.fw-bold #{image.g_image_title}
                                        div.text-center #{image.g_image_desc}
                            .card-footer
                                .text-center.d-flex.justify-content-center.gap-2(style='border:none')
                                    button.btn.btn-warning.editImage.text-dark(type="button" style='font-size: 1rem;cursor: pointer;' data-id=image.id data-title=image.g_image_title data-desc=image.g_image_desc data-image=image.g_image_name)
                                        i.fa.fa-edit
                                        span  Edit
                                    button.btn.bg-danger.removeImage(type="button" style='font-size: 1rem;cursor: pointer;' data-id=image.id data-image=image.g_image_name)
                                        i.fa.fa-trash.text-light 
                                        span Delete

block custom_js
    script(src="/asstest/lightbox/dist/js2/lightbox.js")
    script(src='/asstest/coustom/js/handlers/gallery.js')