extends ../include/print-page-tailwind-layout.pug


block custom_css 
    link(href='/asstest/coustom/css/pagination.css' rel='stylesheet')
    style.
        @media print {
            @page {
                size: landscape;
                //- margin:
            }
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

        table { border-collapse: collapse; width: 100%; }
        td, th {
            padding: 0.3rem;
            border: 1px solid oklch(26.2% 0.051 172.552);
            vertical-align: top;
            font-size:0.8rem;
        }


block content 
    body.tiro-devanagari-marathi-regular
        - const getMonthName = m => ({1:'जानेवारी',2:'फेब्रुवारी',3:'मार्च',4:'एप्रिल',5:'मे',6:'जून',7:'जुलै',8:'ऑगस्ट',9:'सप्टेंबर',10:'ऑक्टोबर',11:'नोव्हेंबर',12:'डिसेंबर'})[m]
        div.hide-print

            div(class="fixed top-1/2 right-0 -translate-y-1/2 flex flex-col items-end gap-2 mr-3 z-50")


                button(class="bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow px-4 py-2 rounded" onclick="window.print()") Print

                - const propertyTypes = [{ label: 'सर्व', value: '' }, { label: 'खुली/जागा प्लॉट', value: 'open_plot' }, { label: 'निवासी', value: 'nivasi' }, { label: 'औद्योगिक', value: 'audhyogik' }, { label: 'वाणिज्य/मनोरा', value: 'vanijya' }];
                select(id="propertyType" class="shadow border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" )
                    each propertyType in propertyTypes
                        - let isSelected = (property_type == propertyType.value)
                        option(value=propertyType.value selected=isSelected) #{propertyType.label} #{isSelected ? `(एकूण ${totalRecords})` : ''}



            .pagination-div
                ul(class='pagination flex items-center')

                    li(class='page-item')
                        button(class='bg-pink-400 text-white w-32 page-link previous-button px-4 py-2 rounded-md') Previous

                    div(class='flex page-numbers w-fit overflow-x-scroll')

                        //- li
                            button(class="px-3 py-1 border border-pink-300 bg-white text-pink-700 hover:bg-pink-100 rounded-md") 1

                        //- li
                            button(class="px-3 py-1 border border-pink-300 bg-white text-pink-700 hover:bg-pink-100 rounded-md") 2


                    li(class='page-item')
                        button(class='bg-pink-400 text-white w-32 page-link next-button px-4 py-2 rounded-md') Next



        div
            each userVal, count in userData

                div(class='card-div inline-block border-[2px] border-yellow-400 rounded-[12px] overflow-hidden bg-[#f8f4e8] w-[460px]')

                    - let website = `https://g-seva.com/pay/${gp.pg_registration_no}/${userVal.id}?rTo=${encodeURIComponent(hostUrl)}`;

                    div(class='mentioned-qr-target-tag hidden' data-target=`qr-code-container-${count}` data-targetUrl=website data-size='170')

                    //- HEADER
                    div(class='bg-gradient-to-r from-blue-700 to-blue-500 text-white text-center py-[5px] px-[8px]')

                        h5(class='text-[18px] font-bold leading-tight')
                            | ग्राम पंचायत #{gp.gp_name}

                        p(class='text-[12px] font-medium leading-none mt-[2px]')
                            | पं. स. #{gp.gp_taluka} | जि. #{gp.gp_dist}

                    //- BODY
                    div(class='p-[8px]')

                        div(class='grid grid-cols-8 gap-[8px] items-start')

                            //- LEFT SIDE
                            div(class='col-span-3')

                                //- MALMATTA NUMBER
                                div(class='mb-[6px]')

                                    div(class='flex items-center flex-wrap gap-[4px]')

                                        span(class='bg-blue-700 text-white text-[11px] font-bold rounded-full px-[8px] py-[2px]')
                                            | मालमत्ता क्र.

                                        span(class='font-sans text-red-600 text-[18px] font-bold leading-none')
                                            | #{userVal.feu_malmattaNo}

                                //- QR
                                div(class='border-[2px] border-blue-700 rounded-[10px] bg-white p-[4px] size-[150px] flex items-center justify-center')

                                    div(id=`qr-code-container-${count}` class='border rounded-md flex items-center justify-center text-xs text-blue-900 font-semibold bg-white')

                            //- RIGHT SIDE
                            div(class='col-span-5 flex flex-col justify-between h-full')

                                //- OWNER
                                div(class='mb-[8px]')

                                    div(class='text-[13px] leading-[20px]')

                                        span(class='inline-block bg-pink-600 text-white font-bold rounded-full px-[8px] py-[2px] mr-[4px]')
                                            | मालमत्ता धारकाचे नाव:

                                        span(class='text-green-800 font-bold break-words')
                                            | #{userVal.feu_ownerName}

                                //- BHOGVATADAR
                                div(class='border-t border-pink-400 pt-[6px] min-h-12')

                                    div(class='text-[13px] leading-[20px]')

                                        span(class='inline-block bg-green-700 text-white font-bold rounded-full px-[8px] py-[2px] mr-[4px]')
                                            | भोगवटदाराचे नाव:

                                        span(class='text-blue-800 text-[16px] font-bold')
                                            | #{userVal.feu_secondOwnerName}

                    //- FOOTER
                    div(class='bg-gradient-to-r from-green-700 to-green-600 text-white text-center py-[5px] px-[6px]')

                        h5(class='text-[16px] font-bold leading-tight')
                            | वेळेत कर भरा आणि गावचा विकास साधा

block custom_js
    script.
        let totalRecords = !{JSON.stringify(totalRecords)}
    
        document.getElementById('propertyType').addEventListener('change', function () {
            const value = this.value;

            const url = new URL(window.location.href);

            if (value) {
                url.searchParams.set('property_type', value);
            } else {
                url.searchParams.delete('property_type');
            }

            window.location.href = url.toString();
        });
    script(src="/asstest/coustom/js/handlers/pagination.js" defer)