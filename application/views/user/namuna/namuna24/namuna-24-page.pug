extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-24/namuna-24-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-24-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना २४ जमिनीची नोंदवही
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a(href="/namuna" class="btn btn-primary btn-sm") नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/24/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='18')
                                | जमिनीची नोंदवही
                        tr
                            th() अनु. क्र
                            th() महिना व वर्ष
                            th() हस्तांतरीत खरेदी किंवा संपादित केल्याची तारीख
                            th() कोणत्या कारी
                            th() कोणाकडून
                            th() करारनामा, निवाडा इत्यादींचा निर्देश
                            th() जमिनीचे क्षेत्रफळ
                            th() भूमापन क्रमांक इत्यादी
                            th() आकारणी
                            th() जमिनीच्या सीमा
                            th() जमिनीसह खरेदी केलेल्या किंवा संपादन केलेल्या कोणत्याही असल्यास
                            th() जमिनीची व इमारतीची विल्हेवाट
                            th() विक्रीपासून मिळालेली रक्कम
                            th() प्रमाणपत्राचा क्रमांक व दिनांक
                            th() मालमत्तेची विल्व्हेवाट लावण्यासाठी पंचायतीचा ठराव क्रमांक व तारीख
                            th() मालमत्तेची विल्व्हेवाट लावण्यासाठी कलम ५५ खालील प्रधिकाऱ्याच्या आदेशाचा क्रमांक व दिनांक
                            th() शेरा
                            th Action

                        tr 
                            each num in Array.from({length: 18}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each namuna24Entry, index in namuna24Details 
                            tr 
                                td #{index +  1}
                                td #{months[namuna24Entry.month - 1] || namuna24Entry.month} / #{namuna24Entry.year}
                                td #{namuna24Entry._transaction_date}
                                td #{namuna24Entry.transaction_reason}
                                td #{namuna24Entry.from_party}
                                td #{namuna24Entry.agreement_reference}
                                td #{namuna24Entry.land_area}
                                td #{namuna24Entry.survey_number}
                                td #{namuna24Entry.land_valuation}
                                td #{namuna24Entry.land_boundaries}
                                td #{namuna24Entry.land_and_building_purchase}
                                td #{namuna24Entry.disposal_of_land_and_building}
                                td #{namuna24Entry.transaction_amount_from_sale}
                                td #{namuna24Entry.certificate_number}, #{namuna24Entry._certificate_date}
                                td #{namuna24Entry.resolution_number}, #{namuna24Entry._resolution_date}
                                td #{namuna24Entry.authority_order_number}, #{namuna24Entry._authority_order_date}
                                td #{namuna24Entry.remarks}
                                td 
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/24/edit/${namuna24Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-24-entry-btn' data-namuna24Entry=namuna24Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-24/namuna-24-page-handler.js' type='module' defer)