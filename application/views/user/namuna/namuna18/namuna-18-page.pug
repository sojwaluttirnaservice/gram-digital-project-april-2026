extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-18/namuna-18-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-18-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना १८- किरकोळ रोकडवही 
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a(href='/namuna' class="btn btn-primary btn-sm") नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/18/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr
                            td(colspan='18')
                                div
                                    div(style='display: flex; align-items: center; justify-content: space-between;')
                                        h4 नमुना १८
                                        h4 ग्रामपंचायत कार्यालय 
                                            span #{gp.gp_name}
                                        div
                                            img(src="/new-gp-page/main-page/images/header-images/mudra-nav-2.png" style='width: 100px;')
                                    div 
                                        h6.text-center(style='font-size:10px;') महा. ग्रा. पं. लेखा संहिता २०११ (नियम २४ (क), ४२ (४) (थ) व ६५ पहा)
                                    div 
                                        if fromYear && toYear
                                            div.text-center(style='font-size: 20px; margin-top:0.2rem;') सन #{fromYear} - #{toYear}, नमुना १८- किरकोळ रोकडवही  
                                        else if (month && year)
                                            div.text-center(style='font-size: 20px; margin-top:0.2rem;') #{month} सन #{year}, नमुना १८- किरकोळ रोकडवही  
                                        else if year 
                                            div.text-center(style='font-size: 20px; margin-top:0.2rem;') सन #{year - 1} - #{year}, नमुना १८- किरकोळ रोकडवही  

                        tr
                            th(rowspan='2') महिना व वर्ष
                            th(rowspan='2') अनु.क्र.
                            th(colspan='7') जमा
                            th(colspan='8') खर्च

                        tr
                            //- For CREDIT / जमा
                            th दिनांक
                            th धनादेश क्रमांक
                            th कोणाकडून प्राप्त झाली
                            th तपशील
                            th रक्कम
                            th अग्रीम
                            th एकूण

                            //- For CREDIT / खर्च
                            th दिनांक
                            th प्रमाणपत्र क्रमांक
                            th कोणास रक्कम दिली
                            th तपशील
                            th रक्कम
                            th अग्रीमातून खर्च
                            th एकूण
                            th Action

                        tr 
                            each marathiNumber in ['१', '२', '३', '४', '५', '६', '७', '८', '९', '१०', '११', '१२', '१३', '१४', '१५', '१६', '१७', '१८']
                                th #{marathiNumber}

                    tbody
                        each namuna18Entry, index in namuna18Details 
                            tr 
                                td #{months[namuna18Entry.month - 1] || namuna18Entry.month} / #{namuna18Entry.year}
                                td #{index + 1}
                                td #{namuna18Entry._recieved_date}
                                td #{namuna18Entry.cheque_number}
                                td #{namuna18Entry.received_from}
                                td #{namuna18Entry.recieved_details}
                                td #{namuna18Entry.recieved_amount}
                                td #{namuna18Entry.recieved_advance_amount}
                                td #{namuna18Entry.total_recieved_amount}

                                td #{namuna18Entry._spending_date}
                                td #{namuna18Entry.certificate_number}
                                td #{namuna18Entry.given_to}
                                td #{namuna18Entry.expense_details}
                                td #{namuna18Entry.expense_amount}
                                td #{namuna18Entry.expense_from_advance}
                                td #{namuna18Entry.total_expense_amount}
                                td 
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/18/edit/${namuna18Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-18-entry-btn' data-namuna18Entry=namuna18Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-18/namuna-18-page-handler.js' type='module' defer)
