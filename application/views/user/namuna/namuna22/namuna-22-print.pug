doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title नमुना २२ प्रिंट स्थावर मालमत्ता नोंदवही (रस्ते व जमिनीव्यतिरिक्त)

        style.
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            table {
                border-collapse: collapse;
                width: 100%;
            }

            tr, th, td {
                border: 1px solid gray;
            }

            th, td {
                padding: 0.1rem 0.4rem;
                text-align: center;
            }

            #hide-buttons {
                button {
                    position: fixed;
                    top: 48%;
                    left: 1rem;
                    background: blue;
                    padding: 0.2rem 0.4rem;
                    color: white;
                }
            }

            /* Print-specific styles */
            @media print {
                @page {
                    size: A4 landscape;
                }
                body {
                    margin: 0;
                }
                tr {
                    break-inside: avoid;
                    page-break-inside: avoid;
                }
                #hide-buttons {
                    display: none;
                }
            }

        link(rel='stylesheet' href='/asstest/coustom/css/namuna/namuna-1-to-33-print.css')

    body
        - const months = ["जानेवारी", "फेब्रुवारी", "मार्च", "एप्रिल", "मे", "जून", "जुलै", "ऑगस्ट", "सप्टेंबर", "ऑक्टोबर", "नोव्हेंबर", "डिसेंबर"]
        #hide-buttons 
            button(type='button' onclick='window.print()') Print

        if namuna22Details && namuna22Details.length > 0
            table(style='width: 100%;')
                thead
                    tr 
                        th(colspan='17')
                            div
                                div(style='display: flex; align-items: center; justify-content: space-between;')
                                    div नमुना २२
                                        if fromYear && toYear
                                            span  (आर्थिक वर्ष: #{fromYear}-#{toYear})
                                        else if month && year
                                            span  (माहे: #{months[month - 1] || month} वर्ष: #{year})
                                    div ग्रामपंचायत कार्यालय 
                                        span #{gp.gp_name}
                                    div
                                        img(src="/new-gp-page/main-page/images/header-images/mudra-nav-2.png" style='width: 100px;')

                                div 
                                    div.text-center(style='font-size:10px;') महा. ग्रा. पं. लेखा संहिता २०११ (नियम ६७ (१) पहा)

                    tr 
                        th(colspan='17')
                            | स्थावर मालमत्ता नोंदवही (रस्ते व जमिनीव्यतिरिक्त)
                    tr
                        th(rowspan='2') अनु. क्र
                        th(rowspan='2') महिना व वर्ष
                        th(rowspan='2') संपादनाची खरेदेची किंवा उभारणीची तारीख
                        th(rowspan='2') ज्या अन्वये मालमत्ता संपादित केली त्या आदेशांची व पंचायत ठरावाचे क्रमांक व दिनांक
                        th(rowspan='2') मालमत्तेचा भूमापन क्रमांक व मालमत्तेचे वर्णन
                        th(rowspan='2') कोणत्या कारणासाठी वापर केला
                        th(rowspan='2') उभारणीचा किंवा संपादनाचा खर्च
                        th(rowspan='1' colspan='5') दुरुस्त्यांवर किंवा फेरफारावर वर्षभरात खर्च करण्यात आलेली रक्कम
                        th(rowspan='2') वर्ष अखेरीस घटलेली किंमत 
                        th(rowspan='2') सरपंच व सचिव यांची आद्यक्षारी
                        th(rowspan='2') मालमत्तेची विल्हेवाट लावण्यासाठी पंचायतीच्या ठरावाचा क्रमांक
                        th(rowspan='2') मालमत्तेची विल्हेवाट लावण्यासाठी कलम ५५ खालील प्राधिकाऱ्याच्या आदेशाचा क्रमांक व तारीख
                        th(rowspan='2') शेरा

                    tr 
                        th(rowspan='1' colspan='1') तारीख
                        th(rowspan='1' colspan='1') चालू दुरुस्त्या
                        th(rowspan='1' colspan='1') विशेष दुरुस्त्या
                        th(rowspan='1' colspan='1') मूळ बांधकाम
                        th(rowspan='1' colspan='1') मूळ बांधकामाचे स्वरूप

                    tr 
                        each num in Array.from({length: 17}, (v, i) => i + 1)
                            th #{num}

                tbody
                    each namuna22Entry, index in namuna22Details 
                        tr 
                            td #{index + 1}
                            td #{months[namuna22Entry.month - 1] || namuna22Entry.month} / #{namuna22Entry.year}
                            td #{namuna22Entry._acquisition_date}
                            td #{namuna22Entry.resolution_number} व #{namuna22Entry._resolution_date}
                            td #{namuna22Entry.survey_number}, #{namuna22Entry.property_description}
                            td #{namuna22Entry.usage_reason}
                            td #{namuna22Entry.construction_or_editing_expense}
                            td #{namuna22Entry._repairs_expenditure_date}
                            td #{namuna22Entry.ongoing_repairs}
                            td #{namuna22Entry.special_repairs}
                            td #{namuna22Entry.original_construction}
                            td #{namuna22Entry.original_construction_type}
                            td #{namuna22Entry.year_end_depreciation}
                            td 
                            td #{namuna22Entry.disposal_resolution_number}
                            td #{namuna22Entry.disposal_order_number}, #{namuna22Entry._disposal_order_date} 
                            td #{namuna22Entry.remarks}

            div(style='margin-top: 1rem; font-weight: 600; margin: 1rem;')
                p टीप: मालमत्तेच्या घसार्सच्या एकूण वार्षिक रकमेचा हीशोब खालील आधारावर करण्यात
                hr
                div(style='display: flex; justify-content: space-between; align-items: center; margin:0.4rem 0rem;')
                    div मालमत्तेचा वर्ग
                    div 
                        div दर ज्याच्या आधारे मूळ किमतीवर शेकडोवारीचा
                        div हिशोब करावयाचा ती संख्या
                    div शेरा
                hr
                div 
                    div इमारत :
                    div(style='display: flex; justify-content: space-between;')
                        div (१) वेतनश्रेणी नोंदवहीत नोंद केलेल्या मंजूर वेतनश्रेणी देयक पडताळून पहिले आहे
                        div(style='width: 3rem;') २.५
                    div(style='display: flex; justify-content: space-between;')
                        div (२) पंधरा रुपयाहून अधिक नाही इतक्या पगारावर लावलेल्या व्यक्तीचे पगार या देयकात काढले आहेत व त्या सर्व व्यक्ती या कामावर लावल्या होत्या
                        div(style='width: 3rem;') ५.०               
                    div(style='display: flex; justify-content: space-between;')
                        div (३) दुसऱ्या वर्गाच्या इमारतीपेक्षा कनिष्ठ परंतु निव्वळ तात्पुरता उभारणी समाविष्ठ नसलेल्या बांधकामाच्या तिसऱ्या वर्गाच्या इमारती
                        div(style='width: 3rem;') ७.५
                    div(style='display: flex; justify-content: space-between;')
                        div (४) लाकडी बांधकामासारखे निव्वळ तात्पुरते इमले.
                        div(style='width: 3rem;') ---
        else 
            if fromYear && toYear
                h3(style='text-align: center; margin-top: 5rem;') सदर आर्थिक वर्ष (#{fromYear}-#{toYear}) नमुना २२ मध्ये नोंदी उपलब्ध नाही.
            else
                h3(style='text-align: center; margin-top: 5rem;') सदर महिना (#{month}) व वर्षासाठी (#{year}) नमुना २२ मध्ये नोंदी उपलब्ध नाही.
