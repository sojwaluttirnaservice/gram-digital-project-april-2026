extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-22/namuna-22-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-22-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना २२ - स्थावर मालमत्ता नोंदवही (रस्ते व जमिनीव्यतिरिक्त)
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a.btn.btn-sm.btn-primary(href='/namuna') नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/22/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='17')
                                | स्थावर मालमत्ता नोंदवही (रस्ते व जमिनीव्यतिरिक्त)
                        tr
                            th(rowspan='2') अनु. क्र
                            th(rowspan='2') महिना व वर्ष
                            th(rowspan='2') संपादनाची खरेदेची किंवा उभारणीची तारीख
                            th(rowspan='2') ज्या अन्वये मालमत्ता संपादित केली त्या आदेशांची व पंचायत ठरावाचे क्रमांक व दिनांक
                            th(rowspan='2') मालमत्तेचा भूमापन क्रमांक व मालमत्तेचे वर्णन
                            th(rowspan='2') कोणत्या कारणासाठी वापर केला
                            th(rowspan='2') उभारणीचा किंवा संपादनाचा खर्च
                            th(rowspan='1' colspan='5') दुरुस्त्यांवर किंवा फेरफारावर वर्षभरात खर्च करण्यात आलेली रक्कम
                            th(rowspan='2') वर्ष अखेरीस घटलेली किंमत 
                            th(rowspan='2') मालमत्तेची विल्हेवाट लावण्यासाठी पंचायतीच्या ठरावाचा क्रमांक
                            th(rowspan='2') मालमत्तेची विल्हेवाट लावण्यासाठी कलम ५५ खालील प्राधिकाऱ्याच्या आदेशाचा क्रमांक व तारीख
                            th(rowspan='2') शेरा
                            th(rowspan='2') Action

                        tr 
                            th(rowspan='1' colspan='1') तारीख
                            th(rowspan='1' colspan='1') चालू दुरुस्त्या
                            th(rowspan='1' colspan='1') विशेष दुरुस्त्या
                            th(rowspan='1' colspan='1') मूळ बांधकाम
                            th(rowspan='1' colspan='1') मूळ बांधकामाचे स्वरूप

                        tr 
                            each num in Array.from({length: 17}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each namuna22Entry, index in namuna22Details 
                            tr 
                                td #{index + 1}
                                td #{months[namuna22Entry.month - 1] || namuna22Entry.month} / #{namuna22Entry.year}
                                td #{namuna22Entry._acquisition_date}
                                td #{namuna22Entry.resolution_number} व #{namuna22Entry._resolution_date}
                                td #{namuna22Entry.survey_number}, #{namuna22Entry.property_description}
                                td #{namuna22Entry.usage_reason}
                                td #{namuna22Entry.construction_or_editing_expense}
                                td #{namuna22Entry._repairs_expenditure_date}
                                td #{namuna22Entry.ongoing_repairs}
                                td #{namuna22Entry.special_repairs}
                                td #{namuna22Entry.original_construction}
                                td #{namuna22Entry.original_construction_type}
                                td #{namuna22Entry.year_end_depreciation}
                                td #{namuna22Entry.disposal_resolution_number}
                                td #{namuna22Entry.disposal_order_number}, #{namuna22Entry._disposal_order_date} 
                                td #{namuna22Entry.remarks}
                                td
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/22/edit/${namuna22Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-22-entry-btn' data-namuna22Entry=namuna22Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-22/namuna-22-page-handler.js' type='module' defer)