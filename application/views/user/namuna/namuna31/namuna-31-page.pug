extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-31/namuna-31-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-31-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना ३१ प्रवास भत्ता देयक 
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a.btn.btn-primary.btn-sm(href='/namuna') नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/31/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='23')
                                | प्रवास भत्ता देयक
                        tr
                            th(rowspan='3') महिना व वर्ष
                            th(rowspan='3') सरपंच/उपसरपंच /सदस्य यांचे नाव
                            th(rowspan='3') कार्यालयाचे ठिकाण

                            //- 3 to 8
                            th(rowspan='1' colspan='6') कार्यालयीन प्रवासाचा तपशील

                            //- 9
                            th(rowspan='3') रेल्वे(मेल, पसेंजर), बोट, रस्त्यावरून धावणाऱ्या/ट्रोली यापैकी केलेल्या प्रवासाचे साधन

                            //- 10 to 12
                            th(rowspan='1' colspan='3') रेल्वे / बोटीचे नाव

                            //- 13 to 15
                            th(rowspan='1' colspan='3') रस्त्याने किंवा ट्रोलीने केलेल्या प्रवासाकरिता मेल भत्ता

                            th(rowspan='1' colspan='3') दैनिक भत्ता

                            th(rowspan='3') प्रवासाचे कारण
                            th(rowspan='3') प्रत्येक स्तंभाची बेरीज

                            th(rowspan='3') शेरा
                            th(rowspan='3') Action

                        tr 
                            th(rowspan='1' colspan='3') निगमन
                            th(rowspan='1' colspan='3') आगमन

                            th(rowspan='2' colspan='1') वर्ग
                            th(rowspan='2' colspan='1') तिकिटांची संख्या
                            th(rowspan='2' colspan='1') रक्कम

                            th(rowspan='2' colspan='1') किमी
                            th(rowspan='2' colspan='1') दर
                            th(rowspan='2' colspan='1') रक्कम

                            th(rowspan='2' colspan='1') दिवसाची संख्या
                            th(rowspan='2' colspan='1') दर
                            th(rowspan='2' colspan='1') रक्कम

                        tr 
                            th(rowspan='1' colspan='1') ठिकाण
                            th(rowspan='1' colspan='1') दिनांक
                            th(rowspan='1' colspan='1') वेळ

                            th(rowspan='1' colspan='1') ठिकाण
                            th(rowspan='1' colspan='1') दिनांक
                            th(rowspan='1' colspan='1') वेळ

                        tr 
                            each num in Array.from({length: 23}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each namuna31Entry, index in namuna31Details 
                            tr 
                                td #{months[namuna31Entry.month - 1] || namuna31Entry.month} / #{namuna31Entry.year}
                                td #{namuna31Entry.name_of_person}
                                td #{namuna31Entry.office_location}

                                td #{namuna31Entry.departure_place}
                                td #{namuna31Entry._departure_date}
                                td #{namuna31Entry._departure_time}

                                td #{namuna31Entry.arrival_place}
                                td #{namuna31Entry._arrival_date}
                                td #{namuna31Entry._arrival_time}

                                td #{namuna31Entry.means_of_travel}

                                td #{namuna31Entry.rail_boat_name_class}
                                td #{namuna31Entry.ticket_count}
                                td #{namuna31Entry.ticket_amount}

                                td #{namuna31Entry.road_distance_km}
                                td #{namuna31Entry.road_rate_per_km}
                                td #{namuna31Entry.road_amount}

                                td #{namuna31Entry.daily_allowance_days}
                                td #{namuna31Entry.daily_allowance_rate}
                                td #{namuna31Entry.daily_allowance_amount}

                                td #{namuna31Entry.travel_reason}
                                td #{namuna31Entry.total_travel_amount}
                                td #{namuna31Entry.remarks}

                                td 
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/31/edit/${namuna31Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-31-entry-btn' data-namuna31Entry=namuna31Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-31/namuna-31-page-handler.js' type='module' defer)