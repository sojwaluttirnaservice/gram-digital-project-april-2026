extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-33/namuna-33-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-33-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना ३३ - वृक्षतोड नोंदवही

        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a.btn.btn-primary.btn-sm(href='/namuna') नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/33/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table.table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='9')
                                |  वृक्ष नोंदवही
                        tr
                            th महिना व वर्ष
                            th जमिनीचा रस्त्याचा तपशील (आधारसामग्रीसह)
                            th वृक्षाचा प्रकार
                            th वृक्षाविषयीची अधिक माहिती
                            th वृक्षांची संख्या
                            th अपेक्षित वार्षिक उत्पन्न
                            th प्रत्यक्ष प्राप्त उत्पन्न
                            th वृक्ष तोडल्यास नष्ट झाल्यास त्याबाबतचा तपशिल
                            th Action 
                        tr 
                            th 1
                            th 2
                            th 3
                            th 4
                            th 5
                            th 6
                            th 7
                            th 8
                            th 9

                    tbody
                        each namuna33Entry, index in namuna33Details 
                            tr 
                                td #{months[namuna33Entry.month - 1] || namuna33Entry.month} / #{namuna33Entry.year}
                                td #{namuna33Entry.land_or_road_details}
                                td #{namuna33Entry.tree_type}
                                td #{namuna33Entry.tree_additional_info}
                                td #{namuna33Entry.tree_count}
                                td #{namuna33Entry.expected_annual_income}
                                td #{namuna33Entry.actual_income_received}
                                td #{namuna33Entry.tree_cut_or_destroyed_details}
                                td
                                    .d-flex.align-items-center.justify-content-center(style='gap: 1rem;')
                                        a.btn.btn-success.btn-sm(href=`/namuna/33/edit/${namuna33Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-33-entry-btn' data-namuna33Entry=namuna33Entry.id) 
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-33/namuna-33-page-handler.js' type='module' defer)
