extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-25/namuna-25-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            color: white;
            border: 1px solid white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-25-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना २५ - गुंतवणुकीची नोंदवही
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a(href="/namuna" class="btn btn-primary btn-sm") नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/25/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='13')
                                | गुंतवणूक नोंदवही
                        tr
                            th(rowspan='2') अनु. क्र
                            th(rowspan='2') महिना व वर्ष
                            th(rowspan='2') गुंतवणुकीची तारीख
                            th(rowspan='2') गुंतवणुकीचा तपशिल बँकेत मुदत ठेव राष्ट्रीय बचत प्रमाणपत्र/सरकारी रोखे सहकारी व इतर क्रमांक व तारीख

                            th(rowspan='1' colspan='2') गुंतवणुकीची रक्कम

                            th(rowspan='2') परिणत होण्याची तारीख
                            th(rowspan='2') निव्वळ देय रक्कम
                            th(rowspan='2') उपार्जित व्याजाची तारीख
                            th(rowspan='2') बदलीचा पदोन्नीत्तेचा दिनांक

                            th(rowspan='2') दैनिक रोकड वहीतील जमा रक्कम
                            th(rowspan='2') प्रक्रतीचां तपशिल
                            th(rowspan='2') Action 

                        tr 
                            th(rowspan='1' colspan='1') दर्शनी मूल्य
                            th(rowspan='1' colspan='1') खरेदी किंमत

                        tr 
                            each num in Array.from({length: 13}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each investment, index in namuna25Details
                            tr
                                td #{index + 1}
                                td #{months[investment.month - 1] || investment.month} / #{investment.year}
                                td #{investment._investment_date}
                                td #{investment.investment_details} / #{investment.reference_number} | #{investment._reference_date}
                                td #{investment.face_value} 
                                td #{investment.purchase_price}
                                td #{investment._maturity_date}
                                td #{investment.net_payable_amount}
                                td #{investment._interest_earned_date}
                                td #{investment._transfer_promotion_date}
                                td #{investment.cashbook_deposited_amount}
                                td #{investment.specific_details}
                                td
                                    .d-flex.align-items-center.justify-content-center(style='gap: 1rem;')
                                        a.btn.btn-success.btn-sm(href=`/namuna/25/edit/${investment.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-25-entry-btn' data-namuna25Entry=investment.id) 
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-25/namuna-25-page-handler.js' type='module' defer)
