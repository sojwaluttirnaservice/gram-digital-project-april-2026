extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-30/namuna-30-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            border: 1px solid white;
            color: white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-30-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना ३० ग्रामपंचायत लेखापरीक्षा आक्षेप पूर्तता नोंदवही 
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a.btn.btn-primary.btn-sm(href='/namuna') नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/30/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='17')
                                |  ग्रामपंचायत लेखापरीक्षा आक्षेप पूर्तता नोंदवही

                        tr
                            th(rowspan='2') अनु. क्र
                            th(rowspan='2') महिना व वर्ष
                            th(rowspan='2') लेखापरीक्षणअहवाल वर्ष
                            th(rowspan='2') लेखापरीक्षण अहवाल प्राप्त झाल्याचा  दिनांक
                            th(rowspan='2') अहवालातील आक्षेपांची संख्या व त्यांचा अनुक्रमांक
                            th(rowspan='2') केवळ माहितीसाठी  असणारा आक्षेप क्रमांक व संख्या 

                            th(rowspan='2') पूर्तताकरावयाच्या आक्षेपांचे क्रमांक व संख्या
                            th(rowspan='2') पूर्तता केलेले आक्षेप पंचायत समितीकडे पाठवविल्याचा जावक क्रमांक व दिनांक
                            th(rowspan='2') पूर्तता केलेले आक्षेप  पंचायत समितीने जि. प. कडे/लेखा परीक्षकाकडे पाठविलेल्याचा ठराव क्रमांक व जावक  क्र. दिनांक

                            th(rowspan='2') जि.प./  लेखा परीक्षक यांनी मंजूर केलेले आक्षेप क्रमांक व संख्या
                            th(rowspan='1' colspan='5') शिल्लक  आक्षेपांची वर्गवारी व क्रमांक

                            th(rowspan='2') शेरा
                            th(rowspan='2') Action

                        tr 
                            th(rowspan='1' colspan='1') पुस्तकी समायोजन
                            th(rowspan='1' colspan='1') वसुली

                            th(rowspan='1' colspan='1') मुल्यांकन
                            th(rowspan='1' colspan='1') नियमबाहय 
                            th(rowspan='1' collapse='1') एकूण

                        tr 
                            each num in Array.from({length: 17}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each namuna30Entry, index in namuna30Details
                            tr 
                                td #{index + 1}
                                td #{months[namuna30Entry.month - 1] || namuna30Entry.month} / #{namuna30Entry.audit_report_year}
                                td #{namuna30Entry.audit_report_year}
                                td #{namuna30Entry._report_received_date}
                                td #{namuna30Entry.objection_count} व #{namuna30Entry.objection_sequence}
                                td #{namuna30Entry.info_only_objection_sequence} व  #{namuna30Entry.info_only_objection_count} 

                                td #{namuna30Entry.resolve_objection_sequence} व #{namuna30Entry.resolve_objection_count} 
                                td #{namuna30Entry.resolved_objection_outward_number} व #{namuna30Entry._resolved_objection_outward_date}
                                td #{namuna30Entry.resolution_forwarded_number} व #{namuna30Entry._resolution_forwarded_date}
                                td #{namuna30Entry.zp_approved_objection_sequence} व #{namuna30Entry.zp_approved_objection_count}
                                td #{namuna30Entry.book_adjustment_details}

                                td #{namuna30Entry.recovery_details}
                                td #{namuna30Entry.assessment_details}
                                td #{namuna30Entry.irregularity_details}
                                td #{namuna30Entry.total_remaining_objection_count}
                                td #{namuna30Entry.remarks}
                                td 
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/30/edit/${namuna30Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-30-entry-btn' data-namuna30Entry=namuna30Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-30/namuna-30-page-handler.js' type='module' defer)