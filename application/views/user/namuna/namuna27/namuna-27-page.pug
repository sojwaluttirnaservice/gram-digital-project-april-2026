extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-27/namuna-27-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            background: teal;
            color: white;
            border: 1px solid white;
            text-align: center;
        }

        td {
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#monthYearModal(tabindex="-1" aria-labelledby="monthYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#monthYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-27-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना २७ - लेखापरीक्षणातील आक्षेपांच्या पूर्ततेचे मासिक विवरण
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#monthYearModal") Print
                a(href="/namuna" class="btn btn-primary btn-sm") नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/27/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(colspan='11')
                                | लेखापरीक्षणातील आक्षेपांच्या पूर्ततेच्या मासिक विवरण
                        tr
                            th(rowspan='1') अनु. क्र
                            th(rowspan='1') महिना व वर्ष
                            th(rowspan='1') लेखापरीक्षण अहवालाचे वर्ष
                            th(rowspan='1') लेखापरीक्षण अहवालातील परिच्छेद संख्या
                            th(rowspan='1') ग्रामपंचायतीने या महिन्यात पूर्तता केलेल्या परीच्छेदांची संख्या
                            th(rowspan='1') पंचायत समितीने मान्य आक्षेपाद्वारे मान्य केलेल्या पुर्तातांची संख्या
                            th(rowspan='1') लेखा परीक्षकाने ज्या बाबतीत पूर्तता मान्य केली आहे त्या अपेक्षांची संख्या
                            th(rowspan='1') प्रलंबित असलेल्या आक्षेपांची संख्या
                            th(rowspan='1') पूर्तता न केल्याबद्दलची कारणे (३-६)
                            th(rowspan='1') शेरा
                            th(rowspan='1') Action

                        tr 
                            each num in Array.from({length: 11}, (v, i) => i + 1)
                                th #{num}

                    tbody
                        each namuna27Entry, index in namuna27Details 
                            tr 
                                td #{index + 1}
                                td #{months[namuna27Entry.month - 1] || namuna27Entry.month} / #{namuna27Entry.audit_report_year}
                                td #{namuna27Entry.audit_report_year}
                                td #{namuna27Entry.paragraph_number}
                                td #{namuna27Entry.paragraphs_resolved_by_gp}
                                td #{namuna27Entry.objections_resolved_by_committee}
                                td #{namuna27Entry.objections_resolved_by_auditor}
                                td #{namuna27Entry.pending_objections}
                                td #{namuna27Entry.reasons_for_non_compliance}
                                td #{namuna27Entry.remarks}
                                td
                                    .d-flex.align-items-center.justify-content-center(style='gap: 1rem;')
                                        a.btn.btn-success.btn-sm(href=`/namuna/27/edit/${namuna27Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-27-entry-btn' data-namuna27Entry=namuna27Entry.id) 
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-27/namuna-27-page-handler.js' type='module' defer)
