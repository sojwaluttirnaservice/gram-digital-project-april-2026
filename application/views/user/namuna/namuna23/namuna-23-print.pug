doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title नमुना २३ प्रिंट

        style.
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            table {
                border-collapse: collapse;
                width: 100%;
            }

            tr, th, td { 
                border: 1px solid gray;
            }

            th, td {
                padding: 0.1rem 0.4rem;
                text-align: center;
            }

            #hide-buttons {
                button {
                    position: fixed;
                    top: 48%;
                    left: 1rem;
                    background: blue;
                    padding: 0.2rem 0.4rem;
                    color: white;
                }
            }

            /* Print-specific styles */
            @media print {
                @page {
                    size: A4 landscape;
                }
                body {
                    margin: 0;
                }
                tr {
                    break-inside: avoid;
                    page-break-inside: avoid;
                }
                #hide-buttons {
                    display: none;
                }
            }

        link(rel='stylesheet' href='/asstest/coustom/css/namuna/namuna-1-to-33-print.css')

    body
        - const months = ["जानेवारी", "फेब्रुवारी", "मार्च", "एप्रिल", "मे", "जून", "जुलै", "ऑगस्ट", "सप्टेंबर", "ऑक्टोबर", "नोव्हेंबर", "डिसेंबर"]
        #hide-buttons 
            button(type='button' onclick='window.print()') Print

        if namuna23Details && namuna23Details.length > 0
            table(style='width: 100%;')
                thead
                    tr 
                        th(colspan='18')
                            div
                                div(style='display: flex; align-items: center; justify-content: space-between;')
                                    div नमुना क्रमांक २३ 
                                        if fromYear && toYear
                                            span  (आर्थिक वर्ष: #{fromYear}-#{toYear})
                                        else if month && year
                                            span  (माहे: #{months[month - 1] || month} वर्ष: #{year})
                                    div ग्रामपंचायत कार्यालय 
                                        span #{gp.gp_name} तालुका : #{gp.gp_taluka} जिल्हा: #{gp.gp_dist}
                                    div
                                        img(src="/new-gp-page/main-page/images/header-images/mudra-nav-2.png" style='width: 100px;')

                                div 
                                    div.text-center(style='font-size:10px;') महा. ग्रा. पं. लेखा संहिता २०११ (नियम ६८ पहा)

                    tr 
                        th(colspan='18')
                            | ताब्यातील रस्त्यांची नोंदवही
                    tr
                        th(rowspan='3') अनु. क्र
                        th(rowspan='3') महिना व वर्ष
                        th(rowspan='3') रस्त्याचे नाव
                        th(rowspan='1' colspan='2') गाव
                        th(rowspan='3') लांबी (किमी)
                        th(rowspan='3') रुंदी (किमी)
                        th(rowspan='3') रस्त्याचा प्रकार (खडीचा, बिनखडीचा डांबरी किंवा सिमेंटचा)
                        th(rowspan='3') पूर्ण केल्याची तारीख
                        th(rowspan='3') प्रति किलोमीटर  रस्ता तयार करण्यात आलेला खर्च
                        th(rowspan='1' colspan='6') दुरुस्त्या
                        th(rowspan='3') शेरा
                        th(rowspan='3') मालमत्तेची पडताळणी केल्याचे दर्शक म्हणून सरपंचवसचिव ह्यांच्या सह्या

                    tr 
                        th(rowspan='2' colspan='1') पासून
                        th(rowspan='2' colspan='1') पर्यंत
                        th(rowspan='1' colspan='2') चालू
                        th(rowspan='1' colspan='2') विशेष
                        th(rowspan='1' colspan='2') मूळ बांधकाम

                    tr 
                        th(rowspan='1' colspan='1') खर्च
                        th(rowspan='1' colspan='1') स्वरूप
                        th(rowspan='1' colspan='1') खर्च
                        th(rowspan='1' colspan='1') स्वरूप
                        th(rowspan='1' colspan='1') खर्च 
                        th(rowspan='1' colspan='1') स्वरूप

                    tr 
                        each num in ['१', '२', '३', '४', '५', '६', '७', '८', '९', '१०', '११(क)', '११(ख)', '११(ग)', '११(घ)', '११(ड)', '११(च)', '१२', '१३']
                            th #{num}

                tbody
                    each namuna23Entry, index in namuna23Details 
                        tr 
                            td #{index + 1}
                            td #{months[namuna23Entry.month - 1] || namuna23Entry.month} / #{namuna23Entry.year}
                            td #{namuna23Entry.road_name}
                            td #{namuna23Entry.start_village}
                            td #{namuna23Entry.end_village}
                            td #{namuna23Entry.length_km}
                            td #{namuna23Entry.width_km}
                            td #{namuna23Entry.road_type}
                            td #{namuna23Entry._completion_date}
                            td #{namuna23Entry.cost_per_km}
                            td #{namuna23Entry.ongoing_repairs_cost}
                            td #{namuna23Entry.ongoing_repairs_form}
                            td #{namuna23Entry.special_repairs_cost}
                            td #{namuna23Entry.special_repairs_form}
                            td #{namuna23Entry.original_construction_cost}
                            td #{namuna23Entry.original_construction_form}
                            td #{namuna23Entry.remarks}
                            td
        else 
            if fromYear && toYear
                h3(style='text-align: center; margin-top: 5rem;') सदर आर्थिक वर्ष (#{fromYear}-#{toYear}) नमुना २३ मध्ये नोंदी उपलब्ध नाही.
            else
                h3(style='text-align: center; margin-top: 5rem;') सदर महिना (#{month}) व वर्षासाठी (#{year}) नमुना २३ मध्ये नोंदी उपलब्ध नाही.
