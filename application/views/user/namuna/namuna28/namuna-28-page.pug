extends ../../include/internal-gp-master-layout.pug

block custom_css
    link(href='/asstest/coustom/css/namuna/namuna-28/namuna-28-page.css' rel='stylesheet')
    style.
        label.error {
            color: red;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
            font-size: 90%;
        }

        tr, td, th {
            border: 1px solid black;
            padding: 0.2rem;
        }

        th {
            color: white;
            background: teal;
            font-size:0.9rem;
            border: 1px solid white;
            text-align: center;
        }

block content
    - 
        const months = [
            "०१ (जानेवारी)", "०२ (फेब्रुवारी)", "०३ (मार्च)", "०४ (एप्रिल)", 
            "०५ (मे)", "०६ (जून)", "०७ (जुलै)", "०८ (ऑगस्ट)", 
            "०९ (सप्टेंबर)", "१० (ऑक्टोबर)", "११ (नोव्हेंबर)", "१२ (डिसेंबर)"
        ]

    .modal.fade#yearToYearModal(tabindex="-1" aria-labelledby="yearToYearModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h1.modal-title.fs-5#yearToYearModalLabel अहवाल प्रिंट करा
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    form(id='month-year-form') 
                        .mb-3
                            label.form-label अहवाल प्रकार निवडा (Select Report Type)
                            select.form-select(name='print_type' id='print-type-select')
                                option(value='month-year') महिना व वर्षानुसार (Month & Year)
                                option(value='financial-year') आर्थिक वर्षानुसार (Financial Year)

                        //- Month/Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#month-year-print-inputs
                            select.form-select(name='month')
                                option(value='' ) -- महिना निवडा--
                                each month, monthIndex in months 
                                    option(value=(monthIndex + 1)) #{month}

                            select.form-select(name='year')
                                option(value='') -- वर्ष निवडा --
                                - let currYear  = new Date().getFullYear()
                                - let startYr = currYear  - 25
                                each year in Array.from({length: currYear  - startYr + 1}, (v, i) => startYr + i).reverse()
                                    option(value=year) #{year}

                        //- Financial Year Inputs
                        .d-flex.align-items-center.justify-content-center.gap-4#financial-year-print-inputs(style="display: none !important;")
                            select.form-select(name='fromYear' id='print-from-year')
                                option(value='') -- पासून (From) --
                                - let currYear2  = new Date().getFullYear() + 1
                                - let startYr2 = currYear2  - 25
                                each year in Array.from({length: currYear2  - startYr2 + 1}, (v, i) => startYr2 + i).reverse()
                                    option(value=year) #{year}

                            select.form-select(name='toYear' id='print-to-year')
                                option(value='') -- पर्यंत (To) --
                                - let currYear3  = new Date().getFullYear() + 2
                                - let startYr3 = currYear3  - 25
                                each year in Array.from({length: currYear3  - startYr3 + 1}, (v, i) => startYr3 + i).reverse()
                                    option(value=year) #{year}

                .modal-footer
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" id='print-namuna-28-btn') Print

    .container
        h2.heading-1.mt-2.mb-1 नमुना २८ - मागासवर्गीय / महिला बालकल्याण खर्च नोंदणी
        div.py-2
            .d-flex.align-items-center.justify-content-end(style="gap: 1rem;")
                button(type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#yearToYearModal") Print
                a.btn.btn-primary.btn-sm(href='/namuna') नमुने

                a.btn.btn-primary.btn-sm(href='/namuna/28/create')
                    .d-flex.gap-2.align-items-center
                        <i class="fa fa-plus"></i>
                        | नवीन नोंदणी 

        .table-container 
            .table-responsive 
                table(style='width: 100%;')
                    thead
                        tr 
                            th(rowspan="2" colspan='1') अनु. क्र
                            th(rowspan="2" colspan='1') महिना व वर्ष
                            th(colspan='9' rowspan='1') मागासवर्गीय १५% खर्च
                            th(colspan='9' rowspan='1') महिला बाल कल्याण १०% खर्च
                            th(colspan='9' rowspan='1') अपंग कल्याण ३%
                            th(rowspan="2") Action
                        tr
                            //- FIRST SECTION
                            th(rowspan="1") सन ___ मध्ये मागासवर्गीयांसाठीम केलेली तरतूद
                            th(rowspan="1") चालू महिन्यात झालेले उत्पन्न
                            th(rowspan="1") टक्के खर्च करावयाची रक्कम
                            th(rowspan="1") खर्चाच्या बाबी बाबवर / योजनावर
                            th(rowspan="1") मागील महिन्यात झालेला खर्च
                            th(rowspan="1") चालू महिन्यात झालेला खर्च
                            th(rowspan="1") एकूण खर्च
                            th(rowspan="1") खर्चाची टक्केवारी
                            th(rowspan="1") शेरा

                            //- SECOND SECTION
                            th(rowspan="1") सन ___ मध्ये मागासवर्गीयांसाठीम केलेली तरतूद
                            th(rowspan="1") चालू महिन्यात झालेले उत्पन्न
                            th(rowspan="1") टक्के खर्च करावयाची रक्कम
                            th(rowspan="1") खर्चाच्या बाबी बाबवर / योजनावर
                            th(rowspan="1") मागील महिन्यात झालेला खर्च
                            th(rowspan="1") चालू महिन्यात झालेला खर्च
                            th(rowspan="1") एकूण खर्च
                            th(rowspan="1") खर्चाची टक्केवारी
                            th(rowspan="1") शेरा

                            //- THIRD SECTION
                            th(rowspan="1") सन ___ मध्ये मागासवर्गीयांसाठीम केलेली तरतूद
                            th(rowspan="1") चालू महिन्यात झालेले उत्पन्न
                            th(rowspan="1") टक्के खर्च करावयाची रक्कम
                            th(rowspan="1") खर्चाच्या बाबी बाबवर / योजनावर
                            th(rowspan="1") मागील महिन्यात झालेला खर्च
                            th(rowspan="1") चालू महिन्यात झालेला खर्च
                            th(rowspan="1") एकूण खर्च
                            th(rowspan="1") खर्चाची टक्केवारी
                            th(rowspan="1") शेरा

                    tbody
                        each namuna28Entry, index in namuna28Details 
                            tr 
                                td #{index +  1}
                                td #{months[namuna28Entry.month - 1] || namuna28Entry.month} / #{namuna28Entry.year}

                                //- FIRST SECTION
                                td #{namuna28Entry.bc_15_provision}
                                td #{namuna28Entry.bc_15_income}
                                td #{namuna28Entry.bc_15_exp_amount}
                                td #{namuna28Entry.bc_15_expenditure_scheme}
                                td #{namuna28Entry.bc_15_expenditure_prev_month}
                                td #{namuna28Entry.bc_15_expenditure_current_month}
                                td #{namuna28Entry.bc_15_total_expenditure}
                                td #{namuna28Entry.bc_15_expenditure_percentage}
                                td #{namuna28Entry.bc_15_remarks}

                                //- SECOND SECTOIN
                                td #{namuna28Entry.wc_10_provision}
                                td #{namuna28Entry.wc_10_income}
                                td #{namuna28Entry.wc_10_exp_amount}
                                td #{namuna28Entry.wc_10_expenditure_scheme}
                                td #{namuna28Entry.wc_10_expenditure_prev_month}
                                td #{namuna28Entry.wc_10_expenditure_current_month}
                                td #{namuna28Entry.wc_10_total_expenditure}
                                td #{namuna28Entry.wc_10_expenditure_percentage}
                                td #{namuna28Entry.wc_10_remarks}

                                //- THIRD SECTION
                                td #{namuna28Entry.dw_5_provision}
                                td #{namuna28Entry.dw_5_income}
                                td #{namuna28Entry.dw_5_exp_amount}
                                td #{namuna28Entry.dw_5_expenditure_scheme}
                                td #{namuna28Entry.dw_5_expenditure_prev_month}
                                td #{namuna28Entry.dw_5_expenditure_current_month}
                                td #{namuna28Entry.dw_5_total_expenditure}
                                td #{namuna28Entry.dw_5_expenditure_percentage}
                                td #{namuna28Entry.dw_5_remarks}

                                td 
                                    .d-flex.align-items-center.justify-content-center.gap-1
                                        a.btn.btn-success.btn-sm(href=`/namuna/28/edit/${namuna28Entry.id}`)
                                            i.fa.fa-pencil

                                        button.btn.btn-danger.btn-sm(class='delete-namuna-28-entry-btn' data-namuna28Entry=namuna28Entry.id)
                                            i.fa.fa-trash

block custom_js
    script(src='/asstest/coustom/js/handlers/namuna/namuna-28/namuna-28-page-handler.js' type='module' defer)